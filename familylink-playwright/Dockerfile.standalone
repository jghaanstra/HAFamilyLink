FROM debian:12-slim

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Install system dependencies required for Playwright, Chromium, VNC and desktop
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-dev \
        curl \
        nodejs \
        npm \
        ca-certificates \
        fonts-liberation \
        libnss3 \
        libatk-bridge2.0-0 \
        libdrm2 \
        libxkbcommon0 \
        libxcomposite1 \
        libxdamage1 \
        libxfixes3 \
        libxrandr2 \
        libgbm1 \
        libasound2 \
        xvfb \
        x11vnc \
        novnc \
        python3-websockify \
        fluxbox \
        dbus \
        xterm \
        chromium \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=0
ENV PYTHONUNBUFFERED=1

ENV LOG_LEVEL=info
ENV AUTH_TIMEOUT=300
ENV SESSION_DURATION=86400
ENV VNC_PASSWORD=familylink

WORKDIR /app

COPY requirements.txt .

RUN pip3 install --no-cache-dir --break-system-packages -r requirements.txt

# Install Playwright and its own Chromium for the application itself
RUN pip3 install --no-cache-dir --break-system-packages playwright \
    && playwright install --with-deps chromium

# Create Docker-safe browser launcher for manual use in noVNC
RUN printf '%s\n' \
    '#!/bin/bash' \
    'exec /usr/bin/chromium --no-sandbox --disable-dev-shm-usage "$@"' \
    > /usr/local/bin/chromium-docker \
    && chmod +x /usr/local/bin/chromium-docker

# Optional desktop entry for the browser
RUN mkdir -p /usr/share/applications \
    && printf '%s\n' \
        '[Desktop Entry]' \
        'Name=Chromium Docker' \
        'Comment=Chromium Browser for Docker/noVNC' \
        'Exec=/usr/local/bin/chromium-docker' \
        'Icon=chromium' \
        'Terminal=false' \
        'Type=Application' \
        'Categories=Network;WebBrowser;' \
        > /usr/share/applications/chromium-docker.desktop

COPY app/ /app/app/

COPY run-standalone.sh /usr/local/bin/run-standalone.sh
RUN chmod +x /usr/local/bin/run-standalone.sh

RUN mkdir -p /share/familylink \
    && chmod 755 /share/familylink

EXPOSE 8099 6080

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8099/api/health || exit 1

LABEL \
    org.opencontainers.image.title="Google Family Link Auth (Standalone)" \
    org.opencontainers.image.description="Standalone authentication service for Google Family Link" \
    org.opencontainers.image.version="1.6.0" \
    org.opencontainers.image.source="https://github.com/noiwid/HAFamilyLink"

CMD ["/usr/local/bin/run-standalone.sh"]