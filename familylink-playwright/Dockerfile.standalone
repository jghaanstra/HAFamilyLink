FROM debian:12-slim

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Install system dependencies required for Playwright, Chromium, VNC and desktop
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-dev \
        curl \
        nodejs \
        npm \
        ca-certificates \
        fonts-liberation \
        libnss3 \
        libatk-bridge2.0-0 \
        libdrm2 \
        libxkbcommon0 \
        libxcomposite1 \
        libxdamage1 \
        libxfixes3 \
        libxrandr2 \
        libgbm1 \
        libasound2 \
        xvfb \
        x11vnc \
        novnc \
        python3-websockify \
        fluxbox \
        dbus \
        xterm \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=0
ENV PYTHONUNBUFFERED=1

ENV LOG_LEVEL=info
ENV AUTH_TIMEOUT=300
ENV SESSION_DURATION=86400
ENV VNC_PASSWORD=familylink

WORKDIR /app

COPY requirements.txt .

RUN pip3 install --no-cache-dir --break-system-packages -r requirements.txt

# Install Playwright and Chromium
RUN pip3 install --no-cache-dir --break-system-packages playwright \
    && playwright install --with-deps chromium

# Create browser wrapper commands for manual use inside noVNC/Fluxbox
RUN set -eux; \
    CHROME_PATH="$(find /ms-playwright -type f -path '*/chrome-linux/chrome' | head -n 1)"; \
    test -n "$CHROME_PATH"; \
    echo "Found Playwright Chromium at: $CHROME_PATH"; \
    printf '#!/bin/bash\nexec "%s" --no-sandbox --disable-dev-shm-usage "$@"\n' "$CHROME_PATH" > /usr/local/bin/chromium; \
    chmod +x /usr/local/bin/chromium; \
    ln -sf /usr/local/bin/chromium /usr/local/bin/chromium-browser; \
    ln -sf /usr/local/bin/chromium /usr/local/bin/google-chrome

# Optional desktop entry
RUN set -eux; \
    mkdir -p /usr/share/applications; \
    printf '%s\n' \
        '[Desktop Entry]' \
        'Name=Chromium' \
        'Comment=Playwright Chromium Browser' \
        'Exec=/usr/local/bin/chromium' \
        'Icon=web-browser' \
        'Terminal=false' \
        'Type=Application' \
        'Categories=Network;WebBrowser;' \
        > /usr/share/applications/chromium.desktop

COPY app/ /app/app/

COPY run-standalone.sh /usr/local/bin/run-standalone.sh
RUN chmod +x /usr/local/bin/run-standalone.sh

RUN mkdir -p /share/familylink \
    && chmod 755 /share/familylink

EXPOSE 8099 6080

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8099/api/health || exit 1

LABEL \
    org.opencontainers.image.title="Google Family Link Auth (Standalone)" \
    org.opencontainers.image.description="Standalone authentication service for Google Family Link" \
    org.opencontainers.image.version="1.6.0" \
    org.opencontainers.image.source="https://github.com/noiwid/HAFamilyLink"

CMD ["/usr/local/bin/run-standalone.sh"]